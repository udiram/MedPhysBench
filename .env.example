# Never commit a populated .env file.
MEDPHYS_BENCH_ENV=development
MEDPHYS_BENCH_RUN_ROOT=./runs
MEDPHYS_BENCH_ARTIFACT_ROOT=./artifacts
MEDPHYS_BENCH_DATABASE_URL=postgresql+psycopg://bench:bench@localhost:5432/medphys_bench
MEDPHYS_BENCH_OBJECT_STORE_ENDPOINT=http://localhost:9000
MEDPHYS_BENCH_OBJECT_STORE_BUCKET=medphys-agentbench

# Provider credentials belong in an approved secret manager in lab/public deployments.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
