{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphysbench.org/schemas/fleet-status.v3.schema.json",
  "title": "MedPhysBench public fleet status v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "fleet_id", "summary", "models"],
  "properties": {
    "schema_version": { "const": "medphysbench.fleet-status.v3" },
    "generated_at": { "type": "string", "format": "date-time" },
    "fleet_id": { "type": "string", "minLength": 1 },
    "summary": { "$ref": "#/$defs/summary" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "size_tier": {
      "enum": ["small", "medium", "large", "frontier", "undisclosed"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_base_models",
        "access_qualified_base_models",
        "evaluated_base_models",
        "ranked_base_models",
        "workflow_view_evaluated_base_models",
        "workflow_view_ranked_base_models",
        "published_system_configurations",
        "published_release_rows",
        "open_planned_models",
        "closed_planned_models",
        "vision_planned_models",
        "steward_count",
        "evaluated_open_base_models",
        "evaluated_closed_base_models",
        "evaluated_vision_base_models",
        "evaluated_image_route_base_models",
        "evaluated_steward_count",
        "evaluated_size_tiers",
        "route_set_count",
        "declared_route_count"
      ],
      "properties": {
        "planned_base_models": { "type": "integer", "minimum": 0 },
        "access_qualified_base_models": { "type": "integer", "minimum": 0 },
        "evaluated_base_models": { "type": "integer", "minimum": 0 },
        "ranked_base_models": { "type": "integer", "minimum": 0 },
        "workflow_view_evaluated_base_models": { "type": "integer", "minimum": 0 },
        "workflow_view_ranked_base_models": { "type": "integer", "minimum": 0 },
        "published_system_configurations": { "type": "integer", "minimum": 0 },
        "published_release_rows": { "type": "integer", "minimum": 0 },
        "open_planned_models": { "type": "integer", "minimum": 0 },
        "closed_planned_models": { "type": "integer", "minimum": 0 },
        "vision_planned_models": { "type": "integer", "minimum": 0 },
        "steward_count": { "type": "integer", "minimum": 0 },
        "evaluated_open_base_models": { "type": "integer", "minimum": 0 },
        "evaluated_closed_base_models": { "type": "integer", "minimum": 0 },
        "evaluated_vision_base_models": { "type": "integer", "minimum": 0 },
        "evaluated_image_route_base_models": { "type": "integer", "minimum": 0 },
        "evaluated_steward_count": { "type": "integer", "minimum": 0 },
        "evaluated_size_tiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/size_tier" }
        },
        "route_set_count": { "type": "integer", "minimum": 1 },
        "declared_route_count": { "type": "integer", "minimum": 1 }
      }
    },
    "access_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "status", "qualification_stage", "surface", "date", "note"],
      "properties": {
        "provider": { "type": ["string", "null"] },
        "model": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "qualification_stage": { "type": ["string", "null"], "enum": ["q0", "q1", "q2", "q3", null] },
        "surface": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "promotion_basis": { "type": ["string", "null"], "enum": ["attested_complete_q2", null] },
        "qualification_evidence": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "submission_id", "manifest_path"],
              "properties": {
                "kind": { "const": "common_harness_submission" },
                "submission_id": { "type": "string", "minLength": 1 },
                "manifest_path": { "type": "string", "pattern": "^submissions/[A-Za-z0-9._-]+\\.json$" }
              }
            }
          ]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_model_id",
        "display_name",
        "steward",
        "family",
        "openness",
        "modalities",
        "evaluated_modalities",
        "size_tier",
        "planned_routes",
        "access_qualified",
        "qualification_stage",
        "evaluated",
        "ranked",
        "workflow_view_evaluated",
        "workflow_view_ranked",
        "system_configuration_count",
        "published_release_count",
        "published_row_count",
        "readiness_state",
        "next_gate",
        "readiness_note",
        "access_evidence"
      ],
      "properties": {
        "base_model_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "steward": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "openness": { "enum": ["open", "closed"] },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "image"] }
        },
        "evaluated_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["text", "image"] }
        },
        "size_tier": { "$ref": "#/$defs/size_tier" },
        "planned_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["anthropic", "aws_bedrock", "codex_native", "cohere", "google", "groq", "ollama", "openai", "self_hosted", "xai"] }
        },
        "access_qualified": { "type": "boolean" },
        "qualification_stage": { "type": ["string", "null"], "enum": ["q0", "q1", "q2", "q3", null] },
        "evaluated": { "type": "boolean" },
        "ranked": { "type": "boolean" },
        "workflow_view_evaluated": { "type": "boolean" },
        "workflow_view_ranked": { "type": "boolean" },
        "system_configuration_count": { "type": "integer", "minimum": 0 },
        "published_release_count": { "type": "integer", "minimum": 0 },
        "published_row_count": { "type": "integer", "minimum": 0 },
        "readiness_state": { "enum": ["route_planned", "access_qualified", "evaluated", "workflow_view_evaluated"] },
        "next_gate": { "enum": ["q0_access", "q2_common_harness", "q2_workflow_view", "q3_comparison"] },
        "readiness_note": { "type": "string", "minLength": 20 },
        "access_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/access_evidence" }
        }
      }
    }
  }
}
