{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphysbench.org/schemas/descriptive-admission.v1.schema.json",
  "title": "MedPhysBench descriptive-only public evidence admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_id",
    "admitted_at",
    "admission_commit",
    "release_file",
    "release_id",
    "scope",
    "review_statement",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "medphysbench.descriptive-admission.v1" },
    "admission_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "admitted_at": { "type": "string", "format": "date-time" },
    "admission_commit": { "$ref": "#/$defs/git_commit" },
    "release_file": { "type": "string", "pattern": "^releases/[A-Za-z0-9._/-]+\\.ya?ml$" },
    "release_id": { "type": "string", "minLength": 1 },
    "scope": { "const": "descriptive_publication_only" },
    "review_statement": { "type": "string", "minLength": 20 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model_name",
          "model_revision",
          "harness_name",
          "harness_revision",
          "results_directory",
          "artifact_count",
          "artifact_tree_sha256",
          "accepted_integrity_errors",
          "limitations"
        ],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "model_name": { "type": "string", "minLength": 1 },
          "model_revision": { "type": "string", "minLength": 1 },
          "harness_name": { "type": "string", "minLength": 1 },
          "harness_revision": { "type": "string", "minLength": 1 },
          "results_directory": {
            "type": "string",
            "pattern": "^results/releases/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "artifact_count": { "type": "integer", "minimum": 1 },
          "artifact_tree_sha256": { "$ref": "#/$defs/sha256" },
          "accepted_integrity_errors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 12 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
