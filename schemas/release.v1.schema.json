{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphys-agentbench.org/schemas/medeval.release.v1.schema.json",
  "title": "MedPhysBench release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "title",
    "description",
    "task_files"
  ],
  "properties": {
    "schema_version": { "const": "medeval.release.v1" },
    "release_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "allow_access_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["public", "gated", "restricted", "private"] }
    },
    "expected_attempts_per_task": {
      "type": "integer",
      "minimum": 1
    },
    "integrity_profile": {
      "enum": ["development", "pilot", "comparison"]
    },
    "public_attempt_detail": {
      "description": "Public evidence projection. Sanitized outputs are permitted only for fully public development/pilot releases, never comparison releases.",
      "enum": ["aggregate_only", "sanitized_output"]
    },
    "max_family_share": {
      "description": "Maximum fraction of release tasks permitted to share one family_id. Tasks without family_id are treated as independent task-ID families. Defaults to 0.5.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "comparison_requirements": {
      "description": "Mandatory protected-holdout gates for comparison-profile releases. The receipt binds public metadata to a separately controlled task bundle without publishing task text or gold labels.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_family_count",
        "minimum_source_dependency_count",
        "holdout_receipt_file",
        "holdout_receipt_sha256"
      ],
      "properties": {
        "minimum_family_count": { "type": "integer", "minimum": 4 },
        "minimum_source_dependency_count": { "type": "integer", "minimum": 3 },
        "holdout_receipt_file": { "type": "string", "minLength": 1 },
        "holdout_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "task_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["integrity_profile"],
        "properties": { "integrity_profile": { "const": "comparison" } }
      },
      "then": {
        "required": ["allow_access_classes", "comparison_requirements"],
        "properties": {
          "allow_access_classes": {
            "not": { "contains": { "const": "public" } }
          },
          "public_attempt_detail": { "const": "aggregate_only" }
        }
      },
      "else": {
        "not": { "required": ["comparison_requirements"] }
      }
    }
  ]
}
