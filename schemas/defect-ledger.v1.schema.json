{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphysbench.org/schemas/defect-ledger.v1.schema.json",
  "title": "MedPhysBench public defect and invalidation ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "entries"],
  "properties": {
    "schema_version": { "const": "medphysbench.defect-ledger.v1" },
    "updated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defect_id",
          "reported_at",
          "status",
          "severity",
          "category",
          "summary",
          "impact",
          "score_treatment",
          "affected_release_ids",
          "affected_task_ids",
          "resolution",
          "evidence"
        ],
        "properties": {
          "defect_id": { "type": "string", "pattern": "^MPB-[0-9]{4}-[0-9]{3}$" },
          "reported_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["reported", "confirmed", "fixed", "withdrawn", "regraded"] },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "category": {
            "enum": ["task_ambiguity", "grader_coverage", "fixture", "leakage", "provenance", "runtime", "rights"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "score_treatment": { "type": "string", "minLength": 1 },
          "affected_release_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "affected_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "target_release_id", "replacement_artifact"],
            "properties": {
              "status": { "enum": ["planned", "in_progress", "complete", "not_applicable"] },
              "target_release_id": { "type": ["string", "null"] },
              "replacement_artifact": { "type": ["string", "null"] }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
