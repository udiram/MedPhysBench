{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphysbench.org/schemas/model-fleet.v1.schema.json",
  "title": "MedPhysBench frozen model fleet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fleet_id",
    "title",
    "frozen_at",
    "target_base_model_count",
    "selection_policy_version",
    "models"
  ],
  "properties": {
    "schema_version": { "const": "medphysbench.model-fleet.v1" },
    "fleet_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "frozen_at": { "type": "string", "format": "date-time" },
    "target_base_model_count": { "type": "integer", "minimum": 1 },
    "selection_policy_version": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_model_id",
        "display_name",
        "steward",
        "family",
        "openness",
        "modalities",
        "size_tier",
        "planned_routes",
        "source_url"
      ],
      "properties": {
        "base_model_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "steward": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "openness": { "enum": ["open", "closed"] },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "image"] }
        },
        "size_tier": { "enum": ["small", "medium", "large", "frontier", "undisclosed"] },
        "planned_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "license": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
