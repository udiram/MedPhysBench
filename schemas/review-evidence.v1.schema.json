{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphysbench.org/schemas/review-evidence.v1.schema.json",
  "title": "MedPhysBench release review evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "release_status",
    "reference_feasibility",
    "independent_domain_review",
    "human_baseline",
    "data_rights_review",
    "task_reviews",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": "medphysbench.review-evidence.v1" },
    "release_id": { "type": "string", "minLength": 1 },
    "release_status": { "enum": ["provisional", "reviewed", "retired"] },
    "reference_feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": { "enum": ["passed", "failed", "pending"] },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "independent_domain_review": { "$ref": "#/$defs/reviewState" },
    "human_baseline": { "$ref": "#/$defs/reviewState" },
    "data_rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": { "enum": ["documented", "pending_independent_confirmation", "blocked"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "task_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "reference_feasibility", "domain_review"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "reference_feasibility": { "enum": ["automated_pass", "failed", "pending"] },
          "domain_review": { "enum": ["approved", "revision_required", "pending"] }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": { "$ref": "#/$defs/nonEmptyStrings" },
        "prohibited": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "reviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completed", "target", "note"],
      "properties": {
        "status": { "enum": ["complete", "recruiting", "pending", "blocked"] },
        "completed": { "type": "integer", "minimum": 0 },
        "target": { "type": "integer", "minimum": 1 },
        "note": { "type": "string", "minLength": 1 },
        "completed_at": { "type": "string", "format": "date-time" },
        "matched_release_id": { "type": "string", "minLength": 1 },
        "evidence_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceArtifact" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
          "then": { "required": ["completed_at", "matched_release_id", "evidence_artifacts"] }
        }
      ]
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
