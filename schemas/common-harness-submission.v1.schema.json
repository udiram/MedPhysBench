{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphysbench.org/schemas/common-harness-submission.v1.schema.json",
  "title": "MedPhysBench auditable common-harness result submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "submission_kind",
    "release_file",
    "release_id",
    "release_contract_hash_v2",
    "repo_commit",
    "adapter_source_commit",
    "harness_source_commit",
    "execution_started_at",
    "execution_finished_at",
    "submitted_at",
    "submitter",
    "model",
    "results_directory",
    "artifact_tree_sha256",
    "artifacts",
    "environment",
    "budget",
    "attestations"
  ],
  "properties": {
    "schema_version": { "const": "medphysbench.common-harness-submission.v1" },
    "submission_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "submission_kind": { "enum": ["managed_local", "external_reproduction"] },
    "release_file": { "type": "string", "pattern": "^releases/[A-Za-z0-9._/-]+\\.ya?ml$" },
    "release_id": { "type": "string", "minLength": 1 },
    "release_contract_hash_v2": { "$ref": "#/$defs/sha256" },
    "repo_commit": { "$ref": "#/$defs/git_commit" },
    "adapter_source_commit": { "$ref": "#/$defs/git_commit" },
    "harness_source_commit": { "$ref": "#/$defs/git_commit" },
    "execution_started_at": { "type": "string", "format": "date-time" },
    "execution_finished_at": { "type": "string", "format": "date-time" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "affiliation"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "affiliation": { "type": "string", "minLength": 2 },
        "contact": { "type": "string", "minLength": 3 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_name",
        "model_revision",
        "base_model_id",
        "harness_name",
        "harness_revision"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string", "minLength": 7 },
        "base_model_id": { "type": "string", "minLength": 1 },
        "harness_name": { "type": "string", "minLength": 1 },
        "harness_revision": { "type": "string", "minLength": 1 }
      }
    },
    "results_directory": {
      "type": "string",
      "pattern": "^results/releases/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "artifact_tree_sha256": { "$ref": "#/$defs/sha256" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.json$"
          },
          "kind": { "enum": ["result", "transport_error"] },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "hardware_summary", "runtime_versions"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "hardware_summary": { "type": "string", "minLength": 3 },
        "accelerator": { "type": ["string", "null"] },
        "runtime_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funding", "estimated_cost_usd"],
      "properties": {
        "funding": { "enum": ["local_compute", "provider_free_tier", "paid_api", "sponsored"] },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_unfiltered_artifact_set",
        "no_manual_output_edits",
        "no_runtime_gold_or_grader_access",
        "no_credentials_or_phi",
        "redistribution_permitted",
        "common_harness_unmodified"
      ],
      "properties": {
        "complete_unfiltered_artifact_set": { "const": true },
        "no_manual_output_edits": { "const": true },
        "no_runtime_gold_or_grader_access": { "const": true },
        "no_credentials_or_phi": { "const": true },
        "redistribution_permitted": { "const": true },
        "common_harness_unmodified": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
