{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medphys-agentbench.org/schemas/medeval.result.v1.schema.json",
  "title": "MedPhys-AgentBench single-trial result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "attempt_index", "manifest", "output", "grades", "trace", "passed", "safe", "score"],
  "properties": {
    "status": { "enum": ["completed", "error"] },
    "attempt_index": { "type": "integer", "minimum": 0 },
    "manifest": { "type": "object" },
    "output": { "type": "object" },
    "grades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grader_id", "passed", "score", "severity", "rationale", "evidence"],
        "properties": {
          "grader_id": { "type": "string" },
          "passed": { "type": "boolean" },
          "score": { "type": "number" },
          "severity": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence": { "type": "object" },
          "lane": {
            "type": "string",
            "minLength": 1
          },
          "required_for_pass": { "type": "boolean" },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    },
    "trace": { "type": "array", "items": { "type": "object" } },
    "raw_response": { "type": "object" },
    "error_type": { "type": "string" },
    "error": { "type": "string" },
    "capability_failure": { "type": "boolean" },
    "model_failure_kind": {
      "enum": ["unsupported_required_modality", "provider_output_contract_failure"]
    },
    "passed": { "type": "boolean" },
    "safe": { "type": "boolean" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "duration_seconds": { "type": "number", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "required": ["error_type", "error", "duration_seconds"] }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["duration_seconds", "raw_response"] }
    }
  ]
}
